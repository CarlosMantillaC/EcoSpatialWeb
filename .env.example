# ---- Base de datos (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5435
DB_USER=ecospatial
DB_PASSWORD=ecospatial
DB_NAME=ecospatial

# Si se define DATABASE_URL, tiene prioridad sobre las variables DB_* individuales
# DATABASE_URL=postgresql://ecospatial:ecospatial@localhost:5432/ecospatial

# SSL de la base de datos. Por defecto se activa si DATABASE_URL esta definido
# (requerido por Render Postgres). En local con Docker suele ir en false.
# DB_SSL=false

# Crear/actualizar tablas automaticamente. Por defecto true fuera de produccion.
# En Render se activa explicitamente hasta contar con migraciones TypeORM.
# DB_SYNCHRONIZE=true

# ---- Backend ----
PORT=3000
NODE_ENV=development
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=8h

# ---- WebAuthn / FIDO2 ----
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=EcoSpatial Web
WEBAUTHN_ORIGIN=http://localhost:5173

# ---- Acceso de demostracion (SOLO DESARROLLO) ----
# Permite iniciar sesion con correo cuando no hay autenticador WebAuthn disponible.
# Se ignora automaticamente si NODE_ENV=production.
DEV_LOGIN_ENABLED=true

# ---- Documentacion OpenAPI (Swagger UI) ----
# UI en /api/docs y documento JSON en /api/docs-json.
# Por defecto activo; ponlo en false para no exponer la documentacion.
# SWAGGER_ENABLED=false

# ---- Administrador semilla ----
# Perfil administrador creado al arrancar si no existe (gestiona sucursales,
# vehiculos, conductores y usuarios; no opera despachos). El correo es solo
# identificador WebAuthn: no se verifica ni llegan mensajes. El perfil no
# nace con dispositivo: hay que inscribirlo desde /enroll con este correo
# (conserva el rol admin).
ADMIN_SEED_EMAIL=admin@ecospatial.com
ADMIN_SEED_NAME=Administrador

# ---- Simulador de flota ----
SIMULATOR_ENABLED=true
# Cada cuanto se mueve la flota (segundos)
SIMULATOR_INTERVAL_SECONDS=3
# Duracion simulada de un viaje completo hasta el destino (segundos).
# El progreso se calcula desde createdAt del despacho, sin estado extra.
SIMULATOR_TRIP_SECONDS=50
# Pausa simulada de carga en el punto de recogida (segundos):
# el viaje reparte el tiempo entre ir a recoger, cargar y entregar.
SIMULATOR_LOAD_PAUSE_SECONDS=8
SIMULATOR_VEHICLE_COUNT=12
# Zona de operacion: Cucuta (Norte de Santander, Colombia).
# Los vehiculos simulados NUNCA salen del perimetro urbano de Cucuta
# (geofence OSM "Perimetro Urbano Cucuta"): si este centro queda fuera
# del perimetro, se usa el centro por defecto.
SIMULATOR_CENTER_LAT=7.889
SIMULATOR_CENTER_LNG=-72.4967

# ---- Routing / OSRM (gratuito, sin API key) ----
OSRM_BASE_URL=https://router.project-osrm.org
