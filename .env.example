# ---- Base de datos (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5435
DB_USER=ecospatial
DB_PASSWORD=ecospatial
DB_NAME=ecospatial

# Si se define DATABASE_URL, tiene prioridad sobre las variables DB_* individuales
# DATABASE_URL=postgresql://ecospatial:ecospatial@localhost:5432/ecospatial

# SSL de la base de datos. Por defecto se activa si DATABASE_URL esta definido
# (requerido por Render Postgres). En local con Docker suele ir en false.
# DB_SSL=false

# Crear/actualizar tablas automaticamente. Por defecto true fuera de produccion.
# En Render se activa explicitamente hasta contar con migraciones TypeORM.
# DB_SYNCHRONIZE=true

# ---- Backend ----
PORT=3000
NODE_ENV=development
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=8h

# ---- WebAuthn / FIDO2 ----
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=EcoSpatial Web
WEBAUTHN_ORIGIN=http://localhost:5173

# ---- Acceso de demostracion (SOLO DESARROLLO) ----
# Permite iniciar sesion con correo cuando no hay autenticador WebAuthn disponible.
# Se ignora automaticamente si NODE_ENV=production.
DEV_LOGIN_ENABLED=true

# ---- Simulador de flota ----
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=15
SIMULATOR_VEHICLE_COUNT=12
SIMULATOR_CENTER_LAT=-0.1807
SIMULATOR_CENTER_LNG=-78.4678

# ---- Routing / OSRM (gratuito, sin API key) ----
OSRM_BASE_URL=https://router.project-osrm.org
